# ==============================================================================
# GMAO System — Plantilla de Configuración de Entorno (.env)
# ==============================================================================
# Copia este archivo como .env y ajusta los valores antes de iniciar el sistema:
#   cp .env.example .env
# O ejecuta el instalador interactivo automatizado:
#   ./install.sh
# ==============================================================================

# ===== BASE DE DATOS POSTGRESQL =====
POSTGRES_USER=gmao_user
POSTGRES_PASSWORD=cambiar_por_contrasena_segura
POSTGRES_DB=gmao_db
DATABASE_URL=postgresql+psycopg2://gmao_user:cambiar_por_contrasena_segura@db/gmao_db

# ===== AUTENTICACIÓN Y SEGURIDAD JWT =====
# Clave secreta para firmar tokens JWT (64 caracteres hexadecimales recomendados).
# Puedes generarla con: openssl rand -hex 32
JWT_SECRET_KEY=generar_clave_aleatoria_segura_32_bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== ADMINISTRADOR INICIAL DEL SISTEMA =====
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambiar_en_primer_login

# ===== INTELIGENCIA ARTIFICIAL (OLLAMA - OPCIONAL) =====
# URL del servidor Ollama para diagnóstico predictivo y chat (dejar por defecto si no se usa)
OLLAMA_URL=http://localhost:11434

# ===== FRONTEND =====
REACT_APP_API_URL=/api