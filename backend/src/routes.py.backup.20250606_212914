    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Crea una orden de trabajo específica para cambio de formato"""
    
    # Validaciones específicas
    if order_data.format_change_type == 'Individual' and not order_data.machine_id:
        raise HTTPException(status_code=400, detail="machine_id es requerido para cambios individuales")
    
    if order_data.format_change_type in ['Línea', 'Global'] and not order_data.affected_machines:
        raise HTTPException(status_code=400, detail="affected_machines es requerido para cambios multi-máquina")
    
    # Verificar que las máquinas existen
    machine_ids_to_check = []
    if order_data.machine_id:
        machine_ids_to_check.append(order_data.machine_id)
    if order_data.affected_machines:
        machine_ids_to_check.extend(order_data.affected_machines)
    
    for mid in machine_ids_to_check:
        machine = db.query(Machine).filter(Machine.id == mid).first()
        if not machine:
            raise HTTPException(status_code=400, detail=f"Máquina con ID {mid} no encontrada")
    
    # Verificar formatos si se proporcionan IDs
    if order_data.format_from_id:
        format_from = db.query(Format).filter(Format.id == order_data.format_from_id).first()
        if not format_from:
            raise HTTPException(status_code=400, detail=f"Formato origen con ID {order_data.format_from_id} no encontrado")
    
    if order_data.format_to_id:
        format_to = db.query(Format).filter(Format.id == order_data.format_to_id).first()
        if not format_to:
            raise HTTPException(status_code=400, detail=f"Formato destino con ID {order_data.format_to_id} no encontrado")
    
    # Crear la orden
    work_order_data = {
        'title': order_data.title,
        'details': order_data.details,
        'work_type': order_data.work_type,
