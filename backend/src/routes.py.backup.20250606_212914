@router.get("/ordenes", response_model=List[WorkOrderRead], summary="Listar Órdenes de Trabajo")
def get_ordenes(
    start: Optional[str] = None,
    end: Optional[str] = None,
    status: Optional[str] = None,
    machine_id: Optional[int] = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """
    Obtiene órdenes de trabajo con filtros según el rol del usuario
    """
    try:
        query = db.query(WorkOrder).options(
            joinedload(WorkOrder.assigned_to),
            joinedload(WorkOrder.machine_obj),
            joinedload(WorkOrder.section),
            joinedload(WorkOrder.line),
            joinedload(WorkOrder.repuesto),
            joinedload(WorkOrder.failure_code),
            joinedload(WorkOrder.cause_code),
            joinedload(WorkOrder.remedy_code)
        )

        # ✅ FILTROS POR ROL CORREGIDOS - TODOS VEN TODAS LAS ÓRDENES
        if current_user.role.nombre == "Jefe de Sección":
            # Jefe de Sección: ve todas las órdenes de su sección
            query = query.filter(WorkOrder.section_id == current_user.section_id)
        # ✅ CAMBIO: Mecánicos, Calidad y Contabilidad ahora ven TODAS las órdenes
        # elif current_user.role.nombre == "Mecánico":
        #     # Comentado: Mecánicos solo ven órdenes asignadas a ellos
        #     query = query.filter(WorkOrder.assigned_to_id == current_user.id)
        elif current_user.role.nombre in ["Mecánico", "Calidad", "Contabilidad"]:
            # ✅ NUEVO: Todos estos roles ven TODAS las órdenes
            # No aplicar filtro adicional, pueden ver todas
            pass
        # Administradores y Jefes de Mantenimiento ven todas (sin filtro)

        # Aplicar filtros de fecha, estado, etc.
        if start and end:
            try:
                sdt = datetime.strptime(start, "%Y-%m-%d")
                edt = datetime.strptime(end, "%Y-%m-%d") + timedelta(days=1)
                query = query.filter(WorkOrder.created_at >= sdt, WorkOrder.created_at < edt)
            except ValueError:
                raise HTTPException(status_code=400, detail="Formato de fecha inválido. Usa YYYY-MM-DD.")

        if status:
            if status not in ['Pendiente', 'En curso', 'En revisión', 'Cerrada']:
                raise HTTPException(status_code=400, detail="Valor de estado inválido.")
            query = query.filter(WorkOrder.status == status)

        if machine_id:
            query = query.filter(WorkOrder.machine_id == machine_id)

        orders = query.order_by(WorkOrder.created_at.desc()).all()
        
        # Debug log para verificar
        logger.info(f"Usuario {current_user.username} (rol: {current_user.role.nombre}) obtuvo {len(orders)} órdenes")
        
        return orders
    except HTTPException as http_exc:
         raise http_exc
    except Exception as e:
         logger.error(f"Error en get_ordenes: {e}", exc_info=True)
         raise HTTPException(status_code=500, detail="Error interno del servidor al obtener órdenes.")

@router.post("/ordenes")
def create_orden(data: WorkOrderCreate, db: Session = Depends(get_db), current_user: User = Depends(get_current_user)):
    try:
        print(f"***** DEBUG CREATE ORDEN *****")
        print(f"work_type: {data.work_type}")
        print(f"machine_id: {data.machine_id}")
        print(f"Details length: {len(data.details) if data.details else 0}")
        print("***** END DEBUG *****")
        
        # ✅ VALIDACIÓN FLEXIBLE PARA machine_id
        is_format_change = data.work_type in ['Cambio de Formato', 'Setup de Línea', 'Cambio Global de Planta']
        
        if not is_format_change and not data.machine_id:
            raise HTTPException(
                status_code=400, 
                detail="machine_id es requerido para órdenes de trabajo normales (no de cambio de formato)"
            )
        
        # Para cambios de formato, redirigir al endpoint específico
        if is_format_change:
            raise HTTPException(
                status_code=400,
                detail="Para órdenes de cambio de formato, usar el endpoint /work-orders/format-change"
            )
        
        print("[DEBUG] Datos recibidos:", data.dict())
        
        # Validación del técnico
        print("[DEBUG] Validando técnico ID:", data.assigned_to_id)
        tecnico = db.query(User).filter(User.id == data.assigned_to_id).first()
        if not tecnico:
            raise HTTPException(status_code=400, detail="Técnico asignado no encontrado")
        
        # Validar máquina (ahora sabemos que machine_id no es None)
        machine = db.query(Machine).filter(Machine.id == data.machine_id).first()
        if not machine:
            raise HTTPException(status_code=400, detail="Máquina no encontrada")
        
        # Validar sección y línea
        sec = db.query(Section).filter(Section.id == data.section_id).first()
        if not sec:
            raise HTTPException(status_code=400, detail="Sección no encontrada")

        line = db.query(Line).filter(Line.id == data.line_id).first()
        if not line:
            raise HTTPException(status_code=400, detail="Línea no encontrada")
        
        # Validación de stock si hay repuesto
        if data.repuesto_id:
            print("[DEBUG] Validando repuesto ID:", data.repuesto_id)
            inv = db.query(Inventory).filter(Inventory.id == data.repuesto_id).first()
            if not inv:
                raise HTTPException(status_code=400, detail="Repuesto no encontrado")
            
            print("[DEBUG] Stock actual:", inv.quantity)
            if inv.quantity < (data.quantity_used or 0):
                print("[DEBUG] Stock insuficiente")
                raise HTTPException(status_code=400, detail="Stock insuficiente")
            
            # Descontar stock
            inv.quantity -= (data.quantity_used or 0)
            print("[DEBUG] Nuevo stock:", inv.quantity)

        # ✅ CREAR LA ORDEN (todos los campos son válidos)
        print("[DEBUG] Creando orden...")
        order = WorkOrder(
            title=data.title,
            details=data.details,
            work_type=data.work_type,
            section_id=data.section_id,
            line_id=data.line_id,
            machine_id=data.machine_id,  # ✅ Garantizado que no es None para órdenes normales
            operator=data.operator,
            assigned_to_id=data.assigned_to_id,
            status=data.status or "Pendiente",
            repuesto_id=data.repuesto_id,
            quantity_used=data.quantity_used or 0,
            imagen_url=data.imagen_url,
            created_at=datetime.utcnow()
        )

        # Generar número de orden
        latest_order = db.query(WorkOrder).order_by(WorkOrder.id.desc()).first()
        next_number = 1 if not latest_order else latest_order.id + 1
        order.order_number = f"OT-{next_number:04d}"

        print("[DEBUG] Guardando orden en la base de datos...")
        db.add(order)
        db.commit()
        db.refresh(order)

        # ✅ PREPARAR RESPUESTA COMPLETA
        return {
            "success": True,
            "data": {
                "id": order.id,
                "order_number": order.order_number,
                "title": order.title,
                "details": order.details,
                "work_type": order.work_type,
                "section_id": order.section_id,
                "line_id": order.line_id,
                "machine_id": order.machine_id,
                "operator": order.operator,
                "assigned_to_id": order.assigned_to_id,
                "status": order.status,
                "created_at": order.created_at.isoformat(),
                "finished_at": order.finished_at.isoformat() if order.finished_at else None,
                "imagen_url": order.imagen_url,
                "section": {"id": sec.id, "nombre": sec.nombre},
                "line": {"id": line.id, "nombre": line.nombre},
                "machine": {"id": machine.id, "nombre": machine.nombre},
                "assigned_to": {"id": tecnico.id, "username": tecnico.username},
                "repuesto_id": order.repuesto_id,
                "quantity_used": order.quantity_used
            }
        }

    except HTTPException as e:
        db.rollback()
        print("[ERROR] HTTPException:", str(e))
        raise e
    except Exception as e:
        db.rollback()
        print("[ERROR] Excepción no manejada:", str(e))
        raise HTTPException(status_code=500, detail=f"Error al crear la orden: {str(e)}")
   
@router.delete("/ordenes/{orden_id}")
def delete_orden(
    orden_id: int, 
    request: Request,  # ← Añadir para audit trail
    db: Session = Depends(get_db), 
    current_user: User = Depends(get_current_user)
):
    # Verificar permisos del usuario
    if current_user.role.nombre not in ["Administrador", "Jefe de Mantenimiento"]:
        raise HTTPException(
            status_code=403, 
            detail="No tienes permiso para eliminar órdenes"
        )
    
    # Buscar la orden
    order = db.query(WorkOrder).filter(WorkOrder.id == orden_id).first()
    if not order:
        raise HTTPException(status_code=404, detail="Orden no encontrada")

    # Si el usuario es Jefe de Sección, solo puede eliminar órdenes de su sección
    if current_user.role.nombre == "Jefe de Sección" and order.section_id != current_user.section_id:
        raise HTTPException(
            status_code=403, 
            detail="Solo puedes eliminar órdenes de tu sección"
        )

    try:
        # ✅ NUEVA LÓGICA: Verificar si está referenciada por un mantenimiento preventivo
        maintenance_referencing = db.query(Maintenance).filter(
            Maintenance.generated_order_id == orden_id
        ).first()
        
        if maintenance_referencing:
            # Limpiar la referencia antes de eliminar la orden
            logger.info(f"Limpiando referencia de mantenimiento ID {maintenance_referencing.id} a orden ID {orden_id}")
            maintenance_referencing.generated_order_id = None
            
            # Si quieres que el mantenimiento vuelva a generar una orden en la próxima fecha
            # puedes mantener la next_maintenance_date como está
            # O si quieres reprogramarlo, descomenta la siguiente línea:
            # maintenance_referencing.next_maintenance_date = datetime.utcnow() + timedelta(days=1)
        
        # Capturar datos para audit trail antes de eliminar
        order_data = {
            "order_number": order.order_number,
            "title": order.title,
            "work_type": order.work_type,
            "status": order.status,
            "machine_id": order.machine_id
        }
        
        # Eliminar la orden
        db.delete(order)
        db.commit()
        
        # Audit trail
        audit_manager.log_action(
            db=db,
            action="DELETE",
            entity=order,  # SQLAlchemy aún tiene referencia antes del commit
            user=current_user,
            request=request,
            old_data=order_data,
            notes=f"Orden eliminada: {order_data['order_number']} - {order_data['title']}",
            metadata={
                "had_maintenance_reference": maintenance_referencing is not None,
                "maintenance_id": maintenance_referencing.id if maintenance_referencing else None
            }
        )
        db.commit()  # Commit del audit log
        
        success_message = "Orden eliminada correctamente"
        if maintenance_referencing:
            success_message += f". Se ha limpiado la referencia del mantenimiento preventivo ID {maintenance_referencing.id}"
        
        return {"success": True, "message": success_message}
        
    except Exception as e:
        db.rollback()
        logger.error(f"Error al eliminar orden {orden_id}: {e}", exc_info=True)
        raise HTTPException(
            status_code=500, 
            detail=f"Error al eliminar la orden: {str(e)}"
        )
        

