{
    "name": "GMAO Dev Container",
    "dockerFile": "Dockerfile",
    "context": "..",
    "appPort": [3000, 8000], // Expone los puertos para el frontend y backend
    "workspaceFolder": "/workspace",
    "settings": {
      "terminal.integrated.shell.linux": "/bin/bash"
    },
    "extensions": [
      "ms-python.python", // Extensión para Python
      "dbaeumer.vscode-eslint", // Extensión para ESLint
      "esbenp.prettier-vscode" // Extensión para Prettier
    ],
    "postCreateCommand": "cd /workspace/frontend && npm install && cd /workspace/backend && pip install -r requirements.txt"
  }